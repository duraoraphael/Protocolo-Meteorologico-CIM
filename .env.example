# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# O arquivo .env nunca deve ser compartilhado ou versionado em git.

# --- Envio de e-mail (Gmail com Senha de App) -------------------------------
# 1. Ative a verificação em 2 etapas em https://myaccount.google.com/security
# 2. Gere uma "Senha de App" em https://myaccount.google.com/apppasswords
# 3. Cole a senha gerada (16 caracteres) abaixo, com ou sem espaços.
GMAIL_USER=usuario@empresa.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_REMETENTE=remetente@empresa.com
ENVIO_EMAIL_ATIVO=true

# Destinatários de fallback, separados por vírgula — só usados para uma base
# que ainda não tem responsável cadastrado no painel (botão 👥). O jeito
# recomendado é cadastrar nome + e-mail por base pelo próprio painel.
# O aviso COR-RIO é isolado e nunca usa este fallback: vincule destinatários
# explicitamente à opção "COR-RIO — RJ" no painel.
REPORT_RECIPIENTS=destinatario@empresa.com

# --- Painel (TV da sala de operação) ----------------------------------------
# Senha para disparar a geração manual do relatório e gerenciar responsáveis
# pelo painel. OBRIGATÓRIA: mínimo 12 caracteres (recomendado 16+ aleatórios);
# sem ela o servidor não inicia. Para gerar uma:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DASHBOARD_PASSWORD=

# --- Base ativa por padrão ----------------------------------------------------
# Chave cadastrada em src/config/cities.js, usada quando o painel abre sem
# ?cidade= na URL. O seletor no topo do painel troca entre todas as bases
# cadastradas a qualquer momento — isso aqui é só o ponto de partida.
CIDADE=rio_de_janeiro

# --- Open-Meteo Weather + Marine + Air Quality -------------------------------
# Em produção/comercial, configure a chave do plano Customer. Sem chave, a
# API pública serve somente para avaliação local; com NODE_ENV=production a
# consulta é bloqueada até a chave ser configurada. O código troca api.* por
# customer-api.* e nunca registra a chave em logs.
OPEN_METEO_API_KEY=

# --- OCEANOP / Petrobras ------------------------------------------------------
# Consulta por coordenadas cadastradas em src/config/oceanopPontos.js.
# Preencha somente credenciais de serviço oficialmente emitidas. O sistema
# também permite diagnóstico sem credencial e registra HTTP 401/403 sem tentar
# contornar o controle de acesso.
OCEANOP_API_KEY=
# OCEANOP_ACCESS_TOKEN=
# Em Windows, o servidor incorpora automaticamente as CAs confiadas pelo
# sistema. Em Linux/contêiner, peça a cadeia corporativa à TI e configure
# NODE_EXTRA_CA_CERTS no ambiente do processo antes de iniciar o Node.

# --- Portal Tetra Tech/OCEANOP — pico diário de rajada -----------------------
# Método preferencial para automação: chave oficial emitida para o backend.
TETRATECH_API_KEY=
# Alternativa: conta técnica OAuth oficialmente autorizada. Não use senha
# pessoal em produção. Se houver login SAML, solicite uma chave/conta de serviço.
TETRATECH_USERNAME=
TETRATECH_PASSWORD=
# Token temporário é aceito apenas para diagnóstico autorizado; expira e não é
# uma configuração operacional estável.
# TETRATECH_ACCESS_TOKEN=

# --- Agendamento automático diário -------------------------------------------
# Envia os informativos exclusivamente às 08h e 15h (America/Sao_Paulo).
ENVIO_AUTOMATICO_DIARIO=true
HORARIOS_INFORMATIVO=08:00,15:00
HORARIOS_COR_RIO=08:00,15:00

# Alertas extraordinários independentes dos informativos, processados por base.
# O primeiro ciclo registra a linha de base e não dispara eventos retroativos.
MONITOR_ALERTAS=true
INTERVALO_MONITOR_MIN=5
JANELA_MONITOR=00:00-24:00
# BASES_MONITOR_ALERTAS=rio_de_janeiro,macae,brasilia,manaus,santos,aracaju,natal,oiapoque,vitoria,araucaria,salvador

# --- Verificação preventiva das fontes ----------------------------------------
# Às 07:30 e 14:30 consulta todas as APIs e confere os campos usados no
# informativo. Havendo problema (fonte fora do ar, layout/formato alterado,
# campos ausentes), avisa a equipe técnica. Sem e-mail configurado, só registra
# no log. Teste manual: npm run verificar-fontes
VERIFICACAO_FONTES=true
# EMAIL_ALERTA_FONTES=suporte.cim@exemplo.com.br,outro@exemplo.com.br
# Para restringir o envio automático a só algumas bases, descomente e ajuste:
# BASES_ENVIO_DIARIO=rio_de_janeiro,macae

# --- Servidor local ------------------------------------------------------------
PORTA=3210
# Interface de escuta. Vazio = todas as interfaces. Atrás de proxy reverso
# (IIS/nginx), use 127.0.0.1.
# HOST=127.0.0.1

# --- HTTPS direto no Node (certificado .pfx da CA corporativa) --------------
# Com as duas definidas, o painel sobe em HTTPS_PORTA e a PORTA acima só
# redireciona HTTP -> HTTPS. Ver INSTALACAO_SERVIDOR_PETROBRAS.md, passo 8.
# HTTPS_PFX_PATH=D:\Certificados\painelcim.pfx
# HTTPS_PFX_SENHA=
# HTTPS_PORTA=3443
# HTTPS_HOST_PUBLICO=painelcim.petrobras.com.br
# Em produção (tarefa agendada), NODE_ENV=production.
# Proxy reverso (IIS/nginx) à frente do Node: informe quantos saltos ou o IP
# do proxy para o controle de tentativas enxergar o IP real do cliente.
# Padrão desligado — NÃO ative sem proxy (X-Forwarded-For seria forjável).
# TRUST_PROXY=127.0.0.1
# Origens https que podem embutir o painel em iframe (ex.: Streamlit). Vazio =
# nenhuma (frame-ancestors 'none' + X-Frame-Options: DENY).
# FRAME_ANCESTORS=https://sua-app.streamlit.app

# Mapeamento operacional do alerta técnico de UV para o protocolo de proteção.
# Os limites técnicos do índice UV continuam independentes. Valores aceitos:
# ATENCAO, ALERTA ou EMERGENCIA. Validar alterações com o CIM.
UV_GRAU_MUITO_ALTO=ATENCAO
UV_GRAU_EXTREMO=ALERTA

# Monitor de Secas (ANA): cada PDF mostra o mapa ESTADUAL da UF da base e o
# texto oficial do mesmo mês. A publicação mais recente (mapa final na API +
# mapas estaduais no bucket da ANA) é descoberta automaticamente, no máximo
# uma vez a cada MONITOR_SECAS_INTERVALO_HORAS (padrão 12; 0 = a cada PDF).
# Cópias validadas em data/monitor-secas/AAAA-MM/ufs/<UF>.png, reutilizadas
# entre bases da mesma UF; em falha, usa a última cópia válida da UF.
# MONITOR_SECAS_INTERVALO_HORAS=12
# Opcional — fixa uma referência mensal (AAAA-MM) em vez da mais recente:
# MONITOR_SECAS_COMPETENCIA=2026-08
