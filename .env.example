# Copie este arquivo para ".env" (mesma pasta) e preencha os valores.
# O arquivo .env nunca deve ser compartilhado ou versionado em git.

# --- Envio de e-mail (Gmail com Senha de App) -------------------------------
# 1. Ative a verificação em 2 etapas em https://myaccount.google.com/security
# 2. Gere uma "Senha de App" em https://myaccount.google.com/apppasswords
# 3. Cole a senha gerada (16 caracteres) abaixo, com ou sem espaços.
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Destinatários de fallback, separados por vírgula — só usados para uma base
# que ainda não tem responsável cadastrado no painel (botão 👥). O jeito
# recomendado é cadastrar nome + e-mail por base pelo próprio painel.
REPORT_RECIPIENTS=heitorfernandesmaciel@gmail.com

# --- Painel (TV da sala de operação) ----------------------------------------
# Senha para disparar a geração manual do relatório e gerenciar responsáveis
# pelo painel. OBRIGATÓRIA: mínimo 12 caracteres (recomendado 16+ aleatórios);
# sem ela o servidor não inicia. Para gerar uma:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
DASHBOARD_PASSWORD=

# --- Base ativa por padrão ----------------------------------------------------
# Chave cadastrada em src/config/cities.js, usada quando o painel abre sem
# ?cidade= na URL. O seletor no topo do painel troca entre todas as bases
# cadastradas a qualquer momento — isso aqui é só o ponto de partida.
CIDADE=rio_de_janeiro

# --- Agendamento automático diário -------------------------------------------
# Por padrão, envia o informativo de TODAS as bases cadastradas em
# src/config/cities.js, cada uma para os seus próprios responsáveis.
ENVIO_AUTOMATICO_DIARIO=true
HORA_ENVIO_DIARIO=06:00
# Para restringir o envio automático a só algumas bases, descomente e ajuste:
# BASES_ENVIO_DIARIO=rio_de_janeiro,macae,cabiunas

# --- Servidor local ------------------------------------------------------------
PORTA=3210
# Interface de escuta. Vazio = todas as interfaces. Atrás de proxy reverso
# (IIS/nginx), use 127.0.0.1.
# HOST=127.0.0.1

# --- HTTPS direto no Node (certificado .pfx da CA corporativa) --------------
# Com as duas definidas, o painel sobe em HTTPS_PORTA e a PORTA acima só
# redireciona HTTP -> HTTPS. Ver INSTALACAO_SERVIDOR_PETROBRAS.md, passo 8.
# HTTPS_PFX_PATH=D:\Certificados\painelcim.pfx
# HTTPS_PFX_SENHA=
# HTTPS_PORTA=3443
# HTTPS_HOST_PUBLICO=painelcim.petrobras.com.br
# Em produção (tarefa agendada), NODE_ENV=production.
# Proxy reverso (IIS/nginx) à frente do Node: informe quantos saltos ou o IP
# do proxy para o controle de tentativas enxergar o IP real do cliente.
# Padrão desligado — NÃO ative sem proxy (X-Forwarded-For seria forjável).
# TRUST_PROXY=127.0.0.1
# Origens https que podem embutir o painel em iframe (ex.: Streamlit). Vazio =
# nenhuma (frame-ancestors 'none' + X-Frame-Options: DENY).
# FRAME_ANCESTORS=https://sua-app.streamlit.app

POINT_FORECAST_MODEL=gfs
WINDY_SEA_MODEL=gfsWave
WINDY_AIR_MODEL=cams

# Windy Point Forecast: chave usada somente no servidor.
WINDY_API_KEY=
